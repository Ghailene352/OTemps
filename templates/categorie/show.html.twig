{% extends 'base.html.twig' %}

{% block title %}{{ categorie.nomCategorie }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">{{ categorie.nomCategorie }}</h1>
        <div class="d-flex gap-2">
            <a href="{{ path('categorie_edit', {idCategorie: categorie.idCategorie}) }}" class="btn btn-outline-secondary btn-sm">Modifier</a>
            {{ include('categorie/_delete_form.html.twig') }}
        </div>
    </div>

    <p>{{ categorie.descriptionType ?: 'Aucune description renseignée.' }}</p>

    <hr>
    <h2 class="h5 mt-3">Objets de cette catégorie</h2>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <p class="mb-0">{{ categorie.objets|length }} objet(s)</p>
        <a href="{{ path('objet_new') }}" class="btn btn-sm btn-dark">+ Nouvel objet</a>
    </div>

    <div class="row g-3">
        {% for objet in categorie.objets %}
            <div class="col-md-6">
                <div class="card card-entity h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">{{ objet.nom }}</h5>
                        <p class="card-text small flex-grow-1">
                            {{ objet.descriptionHistorique ?: 'Aucune description historique.' }}
                        </p>
                        <p class="card-text small text-muted">
                            {% if objet.epoque %}<strong>Époque :</strong> {{ objet.epoque }}<br>{% endif %}
                            {% if objet.origine %}<strong>Origine :</strong> {{ objet.origine }}<br>{% endif %}
                            {% if objet.materiaux %}<strong>Matériaux :</strong> {{ objet.materiaux }}{% endif %}
                        </p>
                        <div class="mt-2">
                            <a href="{{ path('objet_show', {idObjet: objet.idObjet}) }}" class="btn btn-sm btn-outline-dark">Voir l’objet</a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info">
                    Aucun objet dans cette catégorie.
                </div>
            </div>
        {% endfor %}
    </div>

    <a href="{{ path('categorie_index') }}" class="btn btn-link mt-3">← Retour à toutes les catégories</a>
{% endblock %}

