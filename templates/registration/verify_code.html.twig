{% extends 'base.html.twig' %}

{% block title %}Vérification de l'email{% endblock %}

{% block body %}
    <h1>Vérification de votre email</h1>

    {% for message in app.flashes('success') %}
        <div style="color:green;">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div style="color:red;">{{ message }}</div>
    {% endfor %}

    <p>Un code de vérification vous a été envoyé par email. Merci de le saisir ci-dessous pour confirmer votre compte.</p>

    {{ form_start(verifyForm) }}
        {{ form_row(verifyForm.code) }}
        {{ form_row(verifyForm.verify) }}
    {{ form_end(verifyForm) }}

{% endblock %}
