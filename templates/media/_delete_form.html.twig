<form method="post"
      action="{{ path('media_delete', {idMedia: media.idMedia}) }}"
      onsubmit="return confirm('Supprimer définitivement ce média ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete_media_' ~ media.idMedia) }}">
    <button class="btn btn-sm btn-outline-danger">Supprimer</button>
</form>

