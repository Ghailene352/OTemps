{% extends 'base.html.twig' %}

{% block title %}Modifier le média{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">Modifier le média</h1>

    {{ include('media/_form.html.twig', {button_label: 'Mettre à jour'}) }}

    <div class="d-flex justify-content-between align-items-center mt-3">
        <a href="{{ path('media_show', {idMedia: media.idMedia}) }}" class="btn btn-link">← Retour au détail</a>
        {{ include('media/_delete_form.html.twig') }}
    </div>
{% endblock %}

