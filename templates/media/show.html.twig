{% extends 'base.html.twig' %}

{% block title %}Média{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Média</h1>
        <div class="d-flex gap-2">
            <a href="{{ path('media_edit', {idMedia: media.idMedia}) }}" class="btn btn-outline-secondary btn-sm">Modifier</a>
            {{ include('media/_delete_form.html.twig') }}
        </div>
    </div>

    <p class="mb-1">
        <strong>Type :</strong> <span class="badge text-bg-secondary text-uppercase">{{ media.typeMedia }}</span>
    </p>
    <p class="mb-1">
        <strong>Objet :</strong>
        {{ media.objet ? media.objet.nom : '—' }}
    </p>
    <p class="mb-3">
        <strong>Lien :</strong><br>
        <a href="{{ media.lienFichier }}" target="_blank">{{ media.lienFichier }}</a>
    </p>

    <a href="{{ path('media_index') }}" class="btn btn-link mt-3">← Retour à tous les médias</a>
{% endblock %}

