{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}ÔTEMPS - Valorisation du Patrimoine Culturel{% endblock %}</title>

    {# CSS principal #}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    {% endblock %}

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    {# Bloc pour ajouter d'autres styles depuis une page spécifique #}
</head>
<body>
    {# ---------------- En-tête ---------------- #}
    <header class="header">
        <div class="container">
            <div class="header-content">
                <div class="header-left">
                    <button class="mobile-menu-btn" id="mobileMenuBtn">
                        <svg class="menu-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                        <svg class="close-icon hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                    <div class="header-title">
                        <div class="title-group">
                            <h1>ÔTEMPS</h1>
                            <p>Valorisation du Patrimoine Culturel</p>
                        </div>
                    </div>
                </div>
                <div class="header-right">
                    <p>Préserver • Transmettre • Partager</p>
                </div>
            </div>
        </div>
    </header>

    {# ---------------- Layout principal ---------------- #}
    <div class="main-layout">
        {# Sidebar #}
        <aside class="sidebar" id="sidebar">
            <nav class="sidebar-nav">
                <div class="sidebar-header">
                    <h2>Navigation</h2>
                    <p>Explorez notre collection</p>
                </div>

                <div class="nav-items">
                    <button class="nav-item" data-section="objets">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        </svg>
                        <span>Objets Oubliés</span>
                    </button>

                    <button class="nav-item" data-section="quiz">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        <span>Quiz Culturel</span>
                    </button>

                    <button class="nav-item" data-section="evenements">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <span>Événements </span>
                    </button>

                    <button class="nav-item" data-section="apropos">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        <span>À Propos</span>
                    </button>
                </div>

                <div class="sidebar-info">
                    <div class="info-card">
                        <h3>Le saviez-vous ?</h3>
                        <p>Notre collection compte plus de 100 objets patrimoniaux issus de 15 régions différentes.</p>
                    </div>
                </div>
            </nav>
        </aside>

        {# Overlay mobile #}
        <div class="overlay" id="overlay"></div>

        {# Contenu principal #}
        <main class="main-content">
            <div class="content-container">
                {# Bloc pour injecter le contenu spécifique d’une page #}
                {% block body %}{% endblock %}
            </div>

            {# Footer #}
            <footer class="footer">
                <div class="footer-content">
                    <p>© 2026 OTEMPS - Tous droits réservés</p>
                    <p>Préservation du patrimoine culturel matériel et immatériel</p>
                </div>
            </footer>
        </main>
    </div>

    {# Modal pour les détails #}
    <div class="modal" id="modal">
        <div class="modal-overlay" id="modalOverlay"></div>
        <div class="modal-content" id="modalContent">
            {# Contenu dynamique #}
        </div>
    </div>

    {# JS principal #}
    <script src="{{ asset('js/script.js') }}"></script>

    {# Bloc pour ajouter des JS spécifiques à la page #}
    {% block javascripts %}{% endblock %}
</body>
</html>
