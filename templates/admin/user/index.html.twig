{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block body %}
<div class="backend-header">

    <a href="{{ path('admin_user_new') }}" class="btn-add">
        ➕ Ajouter un utilisateur
    </a>
</div>
<h1>Liste des utilisateurs</h1>
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/backend.css') }}">
{% endblock %}
<div class="table-actions">

    <form method="get" action="{{ path('admin_user_search') }}" class="search-form">
        <input
            type="text"
            name="search"
            placeholder="Rechercher par nom"
            value="{{ search ?? '' }}"
        >
        <button type="submit">🔍</button>
    </form>

    <div class="sort-buttons">
        <a href="{{ path('admin_user_sort', { order: 'az' }) }}">A → Z</a>
        <a href="{{ path('admin_user_sort', { order: 'za' }) }}">Z → A</a>
    </div>

</div>

<table class="table-backend">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Email</th>
            <th>Rôle</th>
            <th>Date inscription</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.nom }}</td>
                <td>{{ user.prenom }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.roles|join(', ') }}</td>
                <td>{{ user.dateinscription ? user.dateinscription|date('d/m/Y H:i') : '' }}</td>
                <td>
                    <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn-edit">Modifier</a>
                    <form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Supprimer cet utilisateur ?')" style="display:inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                        <button class="btn-delete" type="submit">Supprimer</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">Aucun utilisateur trouvé.</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
