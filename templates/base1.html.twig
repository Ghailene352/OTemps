<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}OTEMPS{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🏛️</text></svg>">

        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <header class="header">
            <div class="container header-content">
                <div class="header-title">
                    <h1><a href="{{ path('front_home') }}">OTEMPS</a></h1>
                    <p>Patrimoine culturel</p>
                </div>
            </div>
        </header>

        <div class="main-layout">
            

            <main class="main-content">
                <div class="content-container">
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert-template alert-{{ label == 'success' ? 'success' : (label == 'error' ? 'danger' : 'info') }}" role="alert">
                                {{ message }}
                            </div>
                        {% endfor %}
                    {% endfor %}

                    {% block body %}{% endblock %}
                </div>

                <footer class="footer">
                    <div class="footer-content">
                        <p>OTEMPS</p>
                        <p>Gestion du patrimoine culturel</p>
                    </div>
                </footer>
            </main>
        </div>

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </body>
</html>
