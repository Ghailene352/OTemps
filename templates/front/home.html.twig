{% extends 'base1.html.twig' %}

{% block title %}Galerie Royale OTEMPS{% endblock %}

{% block body %}
{# 1. IMPORT DE L'API CHART.JS #}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    :root {
        --gold: #c5a059;
        --wall: #f8f9fa;
        --frame-border: #2c2c2c;
    }

    body { 
        background-color: #ffffff; 
        color: #333; 
        font-family: 'Playfair Display', serif;
    }

    /* --- L'ATMOSPHÈRE DU MUSÉE --- */
    .museum-bg {
        background: linear-gradient(to bottom, #fdfbfb 0%, #ebedee 100%);
        min-height: 100vh;
        padding-bottom: 100px;
    }

    /* --- RECHERCHE ÉPURÉE --- */
    .search-zone {
        padding: 60px 0;
        background: white;
        border-bottom: 1px solid #eee;
        margin-bottom: 40px;
    }

    .search-minimal {
        border: none;
        border-bottom: 1px solid #ccc;
        border-radius: 0;
        font-size: 2rem;
        font-weight: 300;
        text-align: center;
        max-width: 600px;
        margin: 0 auto;
        transition: border-color 0.4s;
    }

    .search-minimal:focus {
        box-shadow: none;
        border-color: var(--gold);
    }

    .btn-category {
        background: none;
        border: 1px solid transparent;
        color: #999;
        text-transform: uppercase;
        letter-spacing: 3px;
        font-size: 0.8rem;
        margin: 0 10px;
        padding: 10px 20px;
        cursor: pointer;
        transition: 0.3s;
    }

    .btn-category.active, .btn-category:hover {
        color: var(--gold);
    }

    /* --- BOUTON STATISTIQUES --- */
    .btn-stats-toggle {
        border: 1px solid var(--gold) !important;
        border-radius: 5px;
        margin-bottom: 20px;
        color: var(--gold);
    }

    .btn-stats-toggle:hover {
        background: var(--gold);
        color: white !important;
    }

    /* --- LA GALERIE --- */
    .gallery-container {
        perspective: 2000px;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 80px;
        padding: 40px;
    }

    .art-piece {
        width: 350px;
        background: white;
        padding: 15px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.05);
        border: 1px solid #efefef;
        transform: rotateX(5deg) rotateY(-10deg);
        transition: all 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
        cursor: pointer;
        position: relative;
    }

    .art-piece:hover {
        transform: rotateX(0deg) rotateY(0deg) scale(1.05);
        box-shadow: 0 30px 60px rgba(0,0,0,0.15);
        z-index: 10;
    }

    .image-box {
        width: 100%;
        height: 450px;
        overflow: hidden;
        border: 8px solid #fff;
        outline: 1px solid #ddd;
    }

    .image-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .label-content { padding-top: 20px; text-align: center; }
    .label-content h3 { font-size: 1.4rem; margin-bottom: 5px; }
    .label-content span { color: var(--gold); text-transform: uppercase; font-size: 0.75rem; }

    .hidden { display: none !important; }
</style>

<div class="museum-bg">
    <div class="search-zone text-center">
        <input type="text" id="searchInput" class="form-control search-minimal mb-5" placeholder="Rechercher une pièce...">
        
        <div class="d-flex justify-content-center flex-wrap mb-4">
            <button class="btn-category active" onclick="filterData('all', this)">Collection Complète</button>
            {% for categorie in categories %}
                <button class="btn-category" onclick="filterData('cat-{{ categorie.idCategorie }}', this)">
                    {{ categorie.nomCategorie }}
                </button>
            {% endfor %}
        </div>

        <button id="btnStats" class="btn-category btn-stats-toggle">
             Voir les Statistiques du Musée
        </button>
    </div>

    {# 2. ZONE DU GRAPHIQUE (CACHÉE PAR DÉFAUT) #}
    <div id="statsSection" class="container my-5 hidden">
        <div class="row justify-content-center">
            <div class="col-md-5" style="background: white; padding: 30px; border-radius: 15px; box-shadow: 0 10px 40px rgba(0,0,0,0.05); border: 1px solid #eee;">
                <h4 class="text-center mb-4" style="color: var(--gold); font-family: 'Playfair Display', serif;">Analyse de la Collection</h4>
                <div style="height: 350px;">
                    <canvas id="museumChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="gallery-container" id="catalogGrid">
            {% for categorie in categories %}
                {% for objet in categorie.objets %}
                    {% set catClass = 'cat-' ~ categorie.idCategorie %}
                    <div class="art-piece objet-card {{ catClass }}" 
                         data-name="{{ objet.nom|lower }}" 
                         onclick="location.href='{{ path('objet_showObject', {'idObjet': objet.idObjet}) }}'">
                        
                        <div class="image-box">
                            {% if objet.medias is not empty %}
                                {% set media = objet.medias[0] %}
                                <img src="{{ media.lienFichier starts with 'http' ? media.lienFichier : asset('uploads/medias/' ~ media.lienFichier) }}" alt="{{ objet.nom }}">
                            {% else %}
                                <img src="{{ asset('images/no-image.jpg') }}" alt="Image manquante">
                            {% endif %}
                        </div>

                        <div class="label-content">
                            <h3>{{ objet.nom }}</h3>
                            <span>{{ categorie.nomCategorie }}</span>
                        </div>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
    </div>
</div>

<div id="noResult" class="text-center mt-5 hidden">
    <p class="text-muted" style="font-size: 1.5rem;">L'œuvre recherchée n'est pas exposée ici.</p>
</div>

<script>
    let activeCategory = 'all';

    // --- 1. LOGIQUE D'AFFICHAGE DU GRAPHIQUE AU CLIC ---
    document.getElementById('btnStats').addEventListener('click', function() {
        const section = document.getElementById('statsSection');
        if (section.classList.contains('hidden')) {
            section.classList.remove('hidden');
            this.innerText = "Masquer les Statistiques";
        } else {
            section.classList.add('hidden');
            this.innerText = "Voir les Statistiques du Musée";
        }
    });

    // --- 2. GESTION DES FILTRES DE RECHERCHE ---
    function filterData(catId, btn) {
        document.querySelectorAll('.btn-category').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeCategory = catId;
        runAllFilters();
    }

    document.getElementById('searchInput').addEventListener('input', runAllFilters);

    function runAllFilters() {
        const query = document.getElementById('searchInput').value.trim().toLowerCase();
        const cards = document.querySelectorAll('.objet-card');
        let visibleCount = 0;

        cards.forEach(card => {
            const name = card.getAttribute('data-name') || "";
            const matchCat = (activeCategory === 'all' || card.classList.contains(activeCategory));
            const matchSearch = name.includes(query);

            if (matchCat && matchSearch) {
                card.classList.remove('hidden');
                visibleCount++;
            } else {
                card.classList.add('hidden');
            }
        });
        document.getElementById('noResult').classList.toggle('hidden', visibleCount > 0);
    }

    // --- 3. INITIALISATION DU GRAPHIQUE (CHART.JS) ---
    document.addEventListener('DOMContentLoaded', function() {
        const ctx = document.getElementById('museumChart').getContext('2d');

        const labelsCategories = [
            {% for cat in categories %} "{{ cat.nomCategorie|e('js') }}", {% endfor %}
        ];

        const countsObjets = [
            {% for cat in categories %} {{ cat.objets|length }}, {% endfor %}
        ];

        new Chart(ctx, {
            type: 'doughnut', 
            data: {
                labels: labelsCategories,
                datasets: [{
                    data: countsObjets,
                    backgroundColor: ['#c5a059', '#2c2c2c', '#d1d1d1', '#8a6d3b', '#e5e5e5'],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });
    });
</script>

<a href="{{ path('front_expert') }}" class="btn btn-warning btn-lg" style="
    position: fixed;
    bottom: 30px;
    right: 30px;
    border-radius: 50%;
    width: 70px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 35px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.3);
    z-index: 1000;
    text-decoration: none;
" title="Ouvrir l'Expert Virtuel">
    🔍
</a>
{% endblock %}