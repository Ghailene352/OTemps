{% extends 'frontbase.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/form-auth.css') }}">
{% endblock %}

{% block body %}
<div class="auth-form">
    <h1>Mot de passe oublié</h1>

    {{ form_start(forgotForm) }}
        <div class="form-group">
            {{ form_label(forgotForm.email) }}
            {{ form_widget(forgotForm.email, {'attr': {'placeholder':'Votre email'}}) }}
            {{ form_errors(forgotForm.email) }}
        </div>
        <button type="submit" class="auth-btn">{{ forgotForm.send.vars.label }}</button>
    {{ form_end(forgotForm) }}

    <div class="auth-footer">
        <a href="{{ path('app_login') }}">Retour à la connexion</a>
    </div>

    {% for flash in app.flashes('error') %}
        <p style="color:red">{{ flash }}</p>
    {% endfor %}
    {% for flash in app.flashes('success') %}
        <p style="color:green">{{ flash }}</p>
    {% endfor %}
</div>
{% endblock %}