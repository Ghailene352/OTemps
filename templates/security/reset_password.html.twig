{% extends 'frontbase.html.twig' %}

{% block title %}Réinitialiser le mot de passe{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/form-auth.css') }}">
{% endblock %}

{% block body %}
<div class="auth-form">
    <h1>Réinitialiser le mot de passe</h1>

    {{ form_start(resetForm) }}
        <div class="form-group">
            {{ form_label(resetForm.code) }}
            {{ form_widget(resetForm.code, {'attr': {'placeholder':'Code reçu par email'}}) }}
            {{ form_errors(resetForm.code) }}
        </div>
        <div class="form-group">
            {{ form_label(resetForm.newPassword) }}
            {{ form_widget(resetForm.newPassword, {'attr': {'placeholder':'Nouveau mot de passe'}}) }}
            {{ form_errors(resetForm.newPassword) }}
        </div>
        <button type="submit" class="auth-btn">{{ resetForm.reset.vars.label }}</button>
    {{ form_end(resetForm) }}

    <div class="auth-footer">
        <a href="{{ path('app_login') }}">Retour à la connexion</a>
    </div>

    {% for flash in app.flashes('error') %}
        <p style="color:red">{{ flash }}</p>
    {% endfor %}
    {% for flash in app.flashes('success') %}
        <p style="color:green">{{ flash }}</p>
    {% endfor %}
</div>
{% endblock %}